{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "designfeed-remix-compiler",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "RemixCompilerContainer",
      "image": "../Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REMIX_COMPILER",
        "class_name": "RemixCompilerContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RemixCompilerContainer"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
