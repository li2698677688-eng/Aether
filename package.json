{
  "name": "aether-designfeed",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/li2698677688-eng/Aether.git"
  },
  "homepage": "https://designfeed-nine.vercel.app",
  "bugs": {
    "url": "https://github.com/li2698677688-eng/Aether/issues"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.21.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "pnpm --dir workers/analyzer typecheck && pnpm --dir services/remix-compiler/cloudflare typecheck",
    "check": "pnpm test && pnpm typecheck && pnpm typecheck:worker && pnpm lint && pnpm build && pnpm performance:budget",
    "check:release": "pnpm check && pnpm peers check && pnpm worker:dry-run && pnpm audit:dependencies",
    "db:start": "supabase start --exclude studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime,mailpit,postgres-meta",
    "db:reset": "supabase db reset --local",
    "db:lint": "supabase db lint --local --level warning",
    "db:stop": "supabase stop",
    "performance:budget": "node scripts/check-performance-budget.mjs",
    "public:scan": "node scripts/check-public-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:dry-run": "pnpm --dir workers/analyzer exec wrangler deploy --dry-run",
    "audit:dependencies": "pnpm audit --audit-level high && pnpm --dir workers/analyzer audit --audit-level high && pnpm --dir services/remix-compiler/cloudflare audit --audit-level high"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "openai": "^7.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "supabase": "2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
