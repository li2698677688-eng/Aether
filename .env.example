NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 只有 Supabase Google Provider 已配置时才设为 true
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
SUPABASE_SERVICE_ROLE_KEY=
# 至少 32 个字符；与 Worker 同名 Secret 一致，但不要与入队密钥复用
ANALYSIS_CALLBACK_SECRET=
ANALYSIS_ENQUEUE_URL=
# 至少 32 个字符；与 Worker 同名 Secret 一致
ANALYSIS_ENQUEUE_SECRET=
# 自托管确定性 Remix 编译器；远程地址必须使用 HTTPS，Key 至少 32 个字符
REMIX_COMPILER_URL=
REMIX_COMPILER_API_KEY=
# 固定已审计的 ditto.site 源码提交，不要使用浮动 main
REMIX_COMPILER_REVISION=3860a1a3a340069eabbfc550fd49807dd10f4f2c
# DesignSpec AI：默认使用 Kimi 中国开放平台；Key 只写入服务端环境变量
DESIGN_AI_PROVIDER=kimi
KIMI_API_KEY=
KIMI_API_BASE_URL=https://api.moonshot.cn/v1
KIMI_DESIGN_MODEL=kimi-k3
# 如需改用 OpenAI，将 DESIGN_AI_PROVIDER 改为 openai 并配置以下两项
OPENAI_API_KEY=
OPENAI_DESIGN_MODEL=gpt-5-mini-2025-08-07
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_QUEUE_NAME=designfeed-analysis
SUPABASE_PRIVATE_SCREENSHOT_BUCKET=site-screenshots-private
SUPABASE_PRIVATE_REMIX_BUCKET=remix_artifacts_private
REMOVAL_CONTACT_EMAIL=
